    "@vercel/functions": "^3.9.11",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.47.0",
    "mongoose": "^9.10.3",
    "next": "16.3.5",
    "nodemailer": "^10.0.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "svix": "^2.6.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
