<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark mode to match RehabLens zinc/emerald design -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Emerald primary color -->
        <item name="colorPrimary">#10b981</item>
        <!-- Dark status bar background -->
        <item name="colorPrimaryDark">#09090b</item>
        <!-- Emerald accent -->
        <item name="colorAccent">#10b981</item>
        <!-- Dark window background -->
        <item name="android:windowBackground">#09090b</item>
        <!-- Allow content to draw under status bar (for camera fullscreen) -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">#09090b</item>
        <!-- Force dark mode always -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#09090b</item>
        <item name="android:navigationBarColor">#09090b</item>
    </style>

    <!-- Splash screen style: shown while app loads -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#09090b</item>
        <item name="android:navigationBarColor">#09090b</item>
    </style>

</resources>